# ═══════════════════════════════════════════════════════════════════
# .env.example - COPY TO .env.local and fill with REAL values
# ═══════════════════════════════════════════════════════════════════
# IMPORTANT: Never commit .env.local to Git! Only .env.example
# Use this file as template for production environment variables

# ═══════════════════════════════════════════════════════════════════
# 🗄️ DATABASE CONFIGURATION (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL Database URL
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# Provider: Neon (https://console.neon.tech/)
# Example: postgresql://neondb_owner:AbCdEf1234@ep-calm-forest-12345.us-east-1.neon.tech/neondb?sslmode=require
# REQUIRED: Yes (Backend + Prisma)
DATABASE_URL="postgresql://username:password@host.region.provider.com:5432/databasename?sslmode=require"

# ═══════════════════════════════════════════════════════════════════
# 🔐 JWT AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════

# JWT Secret - For signing authentication tokens
# Minimum: 32 characters (256 bits recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: Yes (Backend only)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-randomly-generated-hex-string"

# JWT Expiration
# Format: "24h", "7d", "30d"
# Default: "24h" (24 hours)
# REQUIRED: No (uses default if not specified)
JWT_EXPIRATION="24h"

# ═══════════════════════════════════════════════════════════════════
# 🚀 SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Environment Type
# Values: "development" | "production" | "staging"
# REQUIRED: Yes (Affects logging, CORS, etc.)
NODE_ENV="development"

# Frontend URL (for CORS)
# This is where your Next.js frontend runs
# Development: http://localhost:3000
# Production: https://fisafi.vercel.app
# REQUIRED: Yes (Backend CORS validation)
FRONTEND_URL="http://localhost:3000"

# Backend Server Port
# Default: 3001
# REQUIRED: No
BACKEND_PORT="3001"

# Backend API Base URL
# Used by frontend to call API
# Development: http://localhost:3001
# Production: https://fisafi-backend.onrender.com
# REQUIRED: Yes
BACKEND_URL="http://localhost:3001"

# ═══════════════════════════════════════════════════════════════════
# 📧 EMAIL CONFIGURATION (Nodemailer)
# ═══════════════════════════════════════════════════════════════════

# Email Service Provider
# Options: "gmail", "outlook", "sendgrid", "custom"
# REQUIRED: Yes (for contact forms and notifications)
EMAIL_SERVICE="gmail"

# Email Account
# Your email address that sends emails
# Example: contact@fisafigroupe.com or your-name@gmail.com
# REQUIRED: Yes
EMAIL_USER="your-email@gmail.com"

# Email Password / App Password
# For Gmail: Use 16-char App Password (not regular password)
# For Outlook: Use regular password
# For SendGrid: Use API Key
# REQUIRED: Yes
EMAIL_PASSWORD="your-app-password-or-token-here"

# Email Display Name
# What appears as "From" in email clients
# Example: "FISAFI Groupe <contact@fisafigroupe.com>"
# REQUIRED: No
EMAIL_FROM_NAME="FISAFI Groupe"

# Email From Address
# Return path for emails
# Example: contact@fisafigroupe.com
# REQUIRED: Yes
EMAIL_FROM="contact@fisafigroupe.com"

# Custom SMTP Server (if not using predefined service)
# Example: smtp.mailgun.org
# REQUIRED: Only if using "custom" EMAIL_SERVICE
SMTP_HOST="smtp.gmail.com"

# SMTP Port
# Gmail: 587 (TLS) or 465 (SSL)
# Outlook: 587
# REQUIRED: Only if using "custom" EMAIL_SERVICE
SMTP_PORT="587"

# ═══════════════════════════════════════════════════════════════════
# 🖼️ CLOUDINARY IMAGE HOSTING
# ═══════════════════════════════════════════════════════════════════

# Cloudinary Cloud Name
# Your Cloudinary account identifier
# Get from: https://cloudinary.com/console/settings/account
# Format: lowercase-name-123abc
# REQUIRED: Yes (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Cloudinary API Key
# Public API key (safe to expose in frontend)
# Get from: https://cloudinary.com/console/settings/api-keys
# REQUIRED: Yes
CLOUDINARY_API_KEY="123456789012345"

# Cloudinary API Secret
# Private key - BACKEND ONLY, NEVER in frontend!
# Get from: https://cloudinary.com/console/settings/api-keys
# REQUIRED: Yes (Backend only - store in render.yaml or Render dashboard)
CLOUDINARY_API_SECRET="your-secret-api-key-keep-private"

# ═══════════════════════════════════════════════════════════════════
# 🔍 SEO & ANALYTICS
# ═══════════════════════════════════════════════════════════════════

# Google Analytics Tracking ID
# Format: G-XXXXXXXXXX (Google Analytics 4)
# Get from: https://analytics.google.com/
# REQUIRED: No (optional, for analytics)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Site URL (for SEO sitemaps)
# Production: https://fisafigroupe.com
# REQUIRED: Yes
SITE_URL="https://fisafigroupe.com"

# ═══════════════════════════════════════════════════════════════════
# 🌍 API EXTERNAL SERVICES
# ═══════════════════════════════════════════════════════════════════

# Google Maps API Key (if using Google Maps)
# REQUIRED: No (only if using Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ═══════════════════════════════════════════════════════════════════
# 📝 SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════

# 1. COPY THIS FILE:
#    cp .env.example .env.local

# 2. FILL IN YOUR VALUES:
#    - DATABASE_URL: Create PostgreSQL database at Neon.tech
#    - JWT_SECRET: Generate random hex string (see command above)
#    - EMAIL_*: Configure email account
#    - CLOUDINARY_*: Get credentials from cloudinary.com
#    - NEXT_PUBLIC_*: These can be public

# 3. NEVER COMMIT .env.local:
#    - .env.local is in .gitignore
#    - Only .env.example is in Git

# 4. FOR PRODUCTION:
#    - Set NODE_ENV=production
#    - Use strong JWT_SECRET (32+ characters)
#    - Use production DATABASE_URL (Neon or similar)
#    - Configure email with production account
#    - Use HTTPS URLs everywhere

# ═══════════════════════════════════════════════════════════════════
# 🚨 SECURITY WARNINGS
# ═══════════════════════════════════════════════════════════════════

# ⚠️ NEVER:
#   - Commit .env.local to version control
#   - Share JWT_SECRET, DATABASE_URL, or API secrets
#   - Use CLOUDINARY_API_SECRET in frontend code
#   - Use weak passwords or default values
#   - Put secrets in comments

# ✅ ALWAYS:
#   - Use .env.local for local development
#   - Use environment variables for production (Render/Vercel dashboard)
#   - Rotate secrets regularly
#   - Use strong random strings for JWT_SECRET
#   - Keep .env.example clean (example values only)

# ═══════════════════════════════════════════════════════════════════
# 📞 TROUBLESHOOTING
# ═══════════════════════════════════════════════════════════════════

# Database connection failed?
#   → Check DATABASE_URL format
#   → Ensure database exists and is accessible
#   → Check firewall rules if using cloud DB

# Email not sending?
#   → Check EMAIL_USER and EMAIL_PASSWORD
#   → Use App Password for Gmail (16 chars)
#   → Enable "Less secure apps" for Outlook
#   → Check spam folder

# Images not uploading?
#   → Verify CLOUDINARY_* credentials
#   → Check Cloudinary bucket settings
#   → Ensure API secret is in backend only

# JWT authentication failing?
#   → Check JWT_SECRET matches frontend and backend
#   → Ensure token is being sent in Authorization header
#   → Check token hasn't expired (24h default)

# ═══════════════════════════════════════════════════════════════════
