# .env.production.example
# Copy this to .env.production and fill in the values for production

# Database
DATABASE_URL="postgresql://user:password@host:5432/fisafi_prod"

# Server
BACKEND_PORT=3001
BACKEND_HOST="0.0.0.0"
NODE_ENV="production"

# JWT
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION!"
JWT_EXPIRATION="7d"

# CORS
FRONTEND_URL="https://your-domain.com"

# SMTP email delivery (configure these in the backend hosting environment).
EMAIL_HOST="mail.ovh.net"
EMAIL_PORT="587"
EMAIL_USER="contact@fisafigroupe.com"
EMAIL_PASSWORD=
EMAIL_FROM="contact@fisafigroupe.com"
EMAIL_FROM_NAME="FiSAFi Groupe"

# Odoo Market (server-side only; never use a NEXT_PUBLIC_ prefix).
# Use a dedicated Odoo API user with the minimum required product/stock read
# access and customer/quotation create/read access. The website creates draft
# quotations; only the seller confirms them in Odoo.
ODOO_URL="https://fisafigroupe.odoo.com"
ODOO_API_KEY=
